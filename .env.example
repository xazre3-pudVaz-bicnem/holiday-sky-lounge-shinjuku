# 本番ドメイン。ここを変えるだけで canonical / OGP / sitemap / robots / JSON-LD が
# すべて切り替わる。末尾スラッシュは付けない（コード側でも除去している）。
# 未設定時は https://holiday-sky-lounge-shinjuku.vercel.app を使用。
NEXT_PUBLIC_SITE_URL=https://example.com

# GA4 の測定ID。未設定ならタグを読み込まない（架空のIDは入れないこと）。
# 設定すると reservation_click / course_reservation_click / instagram_click /
# phone_click / map_click のイベントが送信される。
NEXT_PUBLIC_GA_ID=

# プレビュー環境で検索避けをしたいときだけ true にする。
# 本番では設定しない（設定すると全ページ noindex になる）。
NEXT_PUBLIC_NOINDEX=
